{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-link-checker.test/schemas/external-risk-rules.schema.json",
  "title": "Local Link Checker External Risk Rules",
  "description": "Schema for --external-risk-rules. Supports allow/block/watch list buckets and explicit rules arrays.",
  "anyOf": [
    {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        { "required": ["allowlist"] },
        { "required": ["allowed"] },
        { "required": ["blocklist"] },
        { "required": ["blocked"] },
        { "required": ["watchlist"] },
        { "required": ["watchlisted"] },
        { "required": ["rules"] }
      ],
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "allowlist": {
          "$ref": "#/$defs/ruleBucket"
        },
        "allowed": {
          "$ref": "#/$defs/ruleBucket"
        },
        "blocklist": {
          "$ref": "#/$defs/ruleBucket"
        },
        "blocked": {
          "$ref": "#/$defs/ruleBucket"
        },
        "watchlist": {
          "$ref": "#/$defs/ruleBucket"
        },
        "watchlisted": {
          "$ref": "#/$defs/ruleBucket"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    }
  ],
  "$defs": {
    "ruleBucket": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/domainEntry"
      }
    },
    "domainEntry": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": true,
          "anyOf": [
            { "required": ["domains"] },
            { "required": ["hostnames"] },
            { "required": ["domain"] },
            { "required": ["hostname"] },
            { "required": ["host"] }
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "domains": {
              "$ref": "#/$defs/domainList"
            },
            "hostnames": {
              "$ref": "#/$defs/domainList"
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "hostname": {
              "type": "string",
              "minLength": 1
            },
            "host": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "rule": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": true,
          "allOf": [
            {
              "anyOf": [
                { "required": ["action"] },
                { "required": ["governanceStatus"] },
                { "required": ["status"] },
                { "required": ["type"] }
              ]
            },
            {
              "anyOf": [
                { "required": ["entry"] },
                { "required": ["domains"] },
                { "required": ["hostnames"] },
                { "required": ["domain"] },
                { "required": ["hostname"] },
                { "required": ["host"] }
              ]
            }
          ],
          "properties": {
            "action": {
              "$ref": "#/$defs/action"
            },
            "governanceStatus": {
              "$ref": "#/$defs/action"
            },
            "status": {
              "$ref": "#/$defs/action"
            },
            "type": {
              "$ref": "#/$defs/action"
            },
            "entry": {
              "$ref": "#/$defs/domainEntry"
            },
            "domains": {
              "$ref": "#/$defs/domainList"
            },
            "hostnames": {
              "$ref": "#/$defs/domainList"
            },
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "hostname": {
              "type": "string",
              "minLength": 1
            },
            "host": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          }
        }
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "allow",
        "allowed",
        "allowlist",
        "block",
        "blocked",
        "blocklist",
        "deny",
        "watch",
        "watchlist",
        "watchlisted"
      ]
    },
    "domainList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
