{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-link-checker.test/schemas/report.schema.json",
  "title": "Local Link Checker Scan Report",
  "description": "Draft schema for the P6.5 scan report contract. This schema captures the minimum stable root, options, summary, checked, broken, and externalLinks shape without constraining every diagnostic field.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "generator",
    "startedAt",
    "completedAt",
    "runStatus",
    "startUrl",
    "options",
    "scanPolicy",
    "compliance",
    "summary",
    "broken",
    "checked",
    "externalLinks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.2.0"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "const": "link-checker.mjs"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    },
    "runStatus": {
      "$ref": "#/$defs/runStatus"
    },
    "startUrl": {
      "type": "string"
    },
    "rulesTrace": {
      "$ref": "#/$defs/rulesTrace"
    },
    "options": {
      "$ref": "#/$defs/options"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "securityPolicy": {
      "$ref": "#/$defs/securityPolicy"
    },
    "scanPolicy": {
      "$ref": "#/$defs/scanPolicy"
    },
    "compliance": {
      "$ref": "#/$defs/compliance"
    },
    "checked": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkedItem"
      }
    },
    "broken": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/brokenItem"
      }
    },
    "externalLinks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalLink"
      }
    }
  },
  "$defs": {
    "rulesTrace": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "domainCategoryRules": {
          "$ref": "#/$defs/rulesTraceEntry"
        },
        "externalRiskRules": {
          "$ref": "#/$defs/rulesTraceEntry"
        },
        "siteLinkRules": {
          "$ref": "#/$defs/rulesTraceEntry"
        }
      }
    },
    "rulesTraceEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "sourceType": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] },
        "finalUrl": { "type": ["string", "null"] },
        "loadedAt": { "type": ["string", "null"] },
        "rulesVersion": { "type": ["string", "null"] },
        "fingerprint": { "type": ["string", "null"] },
        "byteSize": { "type": ["integer", "null"] },
        "ruleCount": { "type": "integer" },
        "redirectCount": { "type": "integer" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "maxPages",
        "maxDepth",
        "concurrency",
        "perHostConcurrency",
        "timeoutMs",
        "retryCount",
        "checkExternal",
        "canonicalStrategy"
      ],
      "properties": {
        "maxPages": { "$ref": "#/$defs/nonNegativeInteger" },
        "maxDepth": { "$ref": "#/$defs/nonNegativeInteger" },
        "concurrency": { "$ref": "#/$defs/positiveInteger" },
        "perHostConcurrency": { "$ref": "#/$defs/positiveInteger" },
        "timeoutMs": { "$ref": "#/$defs/positiveInteger" },
        "retryCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "checkExternal": { "type": "boolean" },
        "canonicalStrategy": {
          "type": "string",
          "enum": ["safe", "moderate", "aggressive"]
        },
        "redactSensitiveQuery": {
          "type": "boolean"
        },
        "redactQueryKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxHtmlBytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "maxBodyPreviewBytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "maxDownloadProbeBytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "maxSourcesPerUrl": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "maxRulesBytes": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "keepAlive": {
          "type": "boolean"
        },
        "maxSockets": {
          "$ref": "#/$defs/positiveInteger"
        },
        "maxFreeSockets": {
          "$ref": "#/$defs/positiveInteger"
        },
        "keepAliveMsecs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "blockPrivateIp": {
          "type": "boolean"
        },
        "allowLocalhost": {
          "type": "boolean"
        },
        "allowPrivateIp": {
          "type": "boolean"
        },
        "retryAfterMaxMs": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "robotsTxt": {
          "type": "boolean"
        },
        "authorizedScan": {
          "type": "boolean"
        },
        "authorizationNote": {
          "type": ["string", "null"]
        },
        "protectionBodyHash": {
          "type": "boolean"
        },
        "cache": {
          "type": "boolean"
        },
        "cacheFile": {
          "type": "string"
        },
        "cacheTtlHours": {
          "$ref": "#/$defs/positiveNumber"
        },
        "refreshCache": {
          "type": "boolean"
        }
      }
    },
    "securityPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "blockPrivateIp": { "type": "boolean" },
        "allowLocalhost": { "type": "boolean" },
        "allowPrivateIp": { "type": "boolean" },
        "metadataIpBlocked": { "type": "boolean" },
        "allowedProtocols": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "scanPolicy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["robotsTxt"],
      "properties": {
        "robotsTxt": {
          "type": "object",
          "additionalProperties": true,
          "required": ["status", "mode", "pathEnforcement"],
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "robots_compliant",
                "robots_not_found",
                "robots_fetch_error",
                "robots_override_authorized",
                "robots_disallow_override_without_declaration",
                "robots_respected_path_skip",
                "robots_disabled"
              ]
            },
            "mode": {
              "type": "string",
              "enum": ["record_only", "disabled"]
            },
            "pathEnforcement": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": true,
      "required": ["purpose", "scope", "authorizedScanDeclared", "robotsTxtPolicy", "robotsTxtEnforced"],
      "properties": {
        "purpose": { "type": "string" },
        "scope": {
          "type": "string",
          "enum": ["same_origin", "same_site", "same_origin_with_external_validation", "mixed", "unknown"]
        },
        "authorizedScanDeclared": { "type": "boolean" },
        "authorizationNote": { "type": ["string", "null"] },
        "robotsTxtPolicy": { "type": "string" },
        "robotsTxtEnforced": { "type": "boolean" },
        "responseBodyStored": { "type": "boolean" },
        "bodyHashEnabled": { "type": "boolean" }
      }
    },
    "runStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "startedAt",
        "completedAt",
        "stoppedByUser",
        "pendingPages",
        "pendingValidations",
        "activeValidationTasks"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["complete", "partial", "failed"]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "stoppedByUser": {
          "type": "boolean"
        },
        "stopReason": {
          "type": "string"
        },
        "failureReason": {
          "type": "string"
        },
        "pendingPages": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "pendingValidations": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "activeValidationTasks": {
          "$ref": "#/$defs/nonNegativeInteger"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pagesCrawled",
        "urlsChecked",
        "brokenLinks",
        "skippedExternal",
        "externalLinks",
        "externalDomains",
        "robotsTxt"
      ],
      "properties": {
        "pagesCrawled": { "$ref": "#/$defs/nonNegativeInteger" },
        "urlsChecked": { "$ref": "#/$defs/nonNegativeInteger" },
        "brokenLinks": { "$ref": "#/$defs/nonNegativeInteger" },
        "skippedExternal": { "$ref": "#/$defs/nonNegativeInteger" },
        "externalLinks": { "$ref": "#/$defs/nonNegativeInteger" },
        "externalDomains": { "$ref": "#/$defs/nonNegativeInteger" },
        "interpretationByCategory": {
          "$ref": "#/$defs/interpretationByCategory"
        },
        "robotsTxt": {
          "$ref": "#/$defs/robotsTxtSummary"
        },
        "cache": {
          "$ref": "#/$defs/cacheSummary"
        },
        "hostDiagnostics": {
          "$ref": "#/$defs/hostDiagnostics"
        }
      }
    },
    "cacheSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "enabled",
        "file",
        "hits",
        "misses",
        "expired",
        "refreshed",
        "written",
        "bypassed",
        "errors",
        "policyVersion",
        "cacheSchemaVersion"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "file": { "type": "string" },
        "hits": { "$ref": "#/$defs/nonNegativeInteger" },
        "misses": { "$ref": "#/$defs/nonNegativeInteger" },
        "expired": { "$ref": "#/$defs/nonNegativeInteger" },
        "refreshed": { "$ref": "#/$defs/nonNegativeInteger" },
        "written": { "$ref": "#/$defs/nonNegativeInteger" },
        "bypassed": { "$ref": "#/$defs/nonNegativeInteger" },
        "errors": { "$ref": "#/$defs/nonNegativeInteger" },
        "policyVersion": { "type": "string" },
        "cacheSchemaVersion": { "type": "string" }
      }
    },
    "hostDiagnostics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "warnings", "hosts"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "warning"]
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "retryAfterMaxMs": {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["host", "urlsChecked", "blockRate", "warnings"],
            "properties": {
              "host": { "type": "string" },
              "urlsChecked": { "$ref": "#/$defs/nonNegativeInteger" },
              "blockRate": { "type": "number" },
              "warnings": {
                "type": "array",
                "items": { "type": "string" }
              },
              "retryAfterCooldowns": { "$ref": "#/$defs/nonNegativeInteger" },
              "retryAfterCooldownMs": { "$ref": "#/$defs/nonNegativeInteger" },
              "maxRetryAfterWaitMs": { "$ref": "#/$defs/nonNegativeInteger" }
            }
          }
        }
      }
    },
    "robotsTxtSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["enabled", "url", "status", "appliesTo", "pathEnforcement"],
      "properties": {
        "enabled": { "type": "boolean" },
        "url": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["not_attempted", "disabled", "ok", "not_found", "http_error", "fetch_error", "blocked_by_security_policy"]
        },
        "appliesTo": { "type": "string" },
        "pathEnforcement": { "type": "boolean" },
        "httpStatus": { "type": ["integer", "null"] },
        "fetchedAt": { "type": ["string", "null"], "format": "date-time" },
        "crawlDelaySeconds": { "type": ["number", "null"] },
        "disallowRules": { "$ref": "#/$defs/nonNegativeInteger" },
        "allowRules": { "$ref": "#/$defs/nonNegativeInteger" },
        "fullDisallow": { "type": "boolean" }
      }
    },
    "checkedItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["url", "ok"],
      "properties": {
        "url": { "type": "string" },
        "canonicalUrl": { "type": ["string", "null"] },
        "ok": { "type": "boolean" },
        "status": { "type": ["integer", "null"] },
        "checkedAt": { "type": ["string", "null"] },
        "bodyBytesRead": { "$ref": "#/$defs/nonNegativeInteger" },
        "bodyTruncated": { "type": "boolean" },
        "bodySignature": {
          "$ref": "#/$defs/bodySignature"
        },
        "interpretation": {
          "$ref": "#/$defs/interpretation"
        },
        "protection": {
          "$ref": "#/$defs/protection"
        },
        "securityPolicy": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "brokenItem": {
      "type": "object",
      "additionalProperties": true,
      "required": ["url", "ok", "sources"],
      "properties": {
        "url": { "type": "string" },
        "ok": { "type": "boolean" },
        "sourceCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "sourcesTruncated": { "type": "boolean" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "bodySignature": {
          "$ref": "#/$defs/bodySignature"
        },
        "interpretation": {
          "$ref": "#/$defs/interpretation"
        },
        "protection": {
          "$ref": "#/$defs/protection"
        }
      }
    },
    "interpretationByCategory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_required": { "$ref": "#/$defs/nonNegativeInteger" },
        "needs_review": { "$ref": "#/$defs/nonNegativeInteger" },
        "external_limited": { "$ref": "#/$defs/nonNegativeInteger" },
        "likely_problem": { "$ref": "#/$defs/nonNegativeInteger" },
        "redirect_ok": { "$ref": "#/$defs/nonNegativeInteger" },
        "ok": { "$ref": "#/$defs/nonNegativeInteger" },
        "page_quality_notice": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "label", "severity", "action", "needsManualReview"],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "action_required",
            "needs_review",
            "external_limited",
            "likely_problem",
            "redirect_ok",
            "ok",
            "page_quality_notice"
          ]
        },
        "label": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["high", "medium", "review", "info", "ok", "notice"]
        },
        "action": { "type": "string" },
        "needsManualReview": { "type": "boolean" }
      }
    },
    "bodySignature": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "required": ["signatureType", "matchedPatterns"],
      "properties": {
        "signatureType": { "type": "string" },
        "matchedPatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bodyHash": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "snippet": { "type": "string" }
      }
    },
    "protection": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "required": ["provider", "headerEvidence", "bodySignatureRuleIds"],
      "properties": {
        "provider": { "type": ["string", "null"] },
        "status": { "type": ["integer", "null"] },
        "title": { "type": ["string", "null"] },
        "blockedReason": { "type": ["string", "null"] },
        "blockedRuleId": { "type": ["string", "null"] },
        "suspectedWaf": { "type": "boolean" },
        "suspectedBot": { "type": "boolean" },
        "headerEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["header", "value"],
            "properties": {
              "header": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "bodySignatureRuleIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "matchedPatterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "evidence": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "externalLink": {
      "type": "object",
      "additionalProperties": true,
      "required": ["url", "hostname", "type", "sourceCount", "sources"],
      "properties": {
        "url": { "type": "string" },
        "canonicalUrl": { "type": ["string", "null"] },
        "hostname": { "type": "string" },
        "registrableDomain": { "type": ["string", "null"] },
        "type": { "type": "string" },
        "sourceCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "sourcesTruncated": { "type": "boolean" },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    }
  }
}
